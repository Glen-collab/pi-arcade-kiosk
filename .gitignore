# ROMs are user-supplied, never commit copyrighted content
roms/nes/*.nes
roms/snes/*.sfc
roms/snes/*.smc
roms/ps1/*.chd
roms/ps1/*.bin
roms/ps1/*.cue

# PS1 BIOS (when added later)
bios/

# Python
__pycache__/
*.pyc
.venv/

# Editor noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Runtime state, written by the running kiosk. Tracking these means every
# deploy overwrites the cabinet's live play counts and parent settings with
# whatever stale copy is in the repo — which is exactly what happened.
backend/plays.json
backend/prefs.json
